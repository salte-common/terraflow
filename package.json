{
  "name": "@salte-common/terraflow",
  "version": "1.0.0-beta.2",
  "description": "Opinionated Terraform workflow CLI with multi-cloud support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "terraflow": "./bin/terraflow.js",
    "tf": "./bin/tf.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "rm -rf dist/templates && cp -r src/templates dist/templates",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "terraform",
    "infrastructure",
    "iac",
    "devops",
    "cli",
    "aws",
    "azure",
    "gcp"
  ],
  "author": "Dave Woodward",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/salte-common/terraflow.git"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1096.0",
    "@aws-sdk/client-sts": "^3.1096.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
