terraform {
  required_version = ">= 1.0"
  
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.0"
    }
  }
  
  backend "gcs" {
    # Backend configuration provided via terraflow
  }
}

provider "google" {
  project = var.gcp_project_id
  # Region automatically read from GOOGLE_REGION environment variable
}

